                ECR_REPO = 'uat-apigateway'
            }
            steps {
                script {
                    sh "docker build --build-arg SERVICE_NAME=${SERVICE_NAME} -t ${ECR_BASE_URL}/${ECR_REPO}:latest . -f devops/Dockerfiles/Dockerfile-all"
                    sh "docker push ${ECR_BASE_URL}/${ECR_REPO}:latest"
                    sh "sleep 5"
                    sh "kubectl rollout restart deployment/apigateway"
