{
  "name": "@insurance-wellness-hub/ai-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "node-env=development"
            ]
          }
        }
      },
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@insurance-wellness-hub/ai-service:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@insurance-wellness-hub/ai-service:build:development"
          },
          "production": {
            "buildTarget": "@insurance-wellness-hub/ai-service:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "devDependencies": {
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.5"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
